{
  "name": "qlib-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "sync:formal-model-runs": "node scripts/sync-formal-model-runs.mjs",
    "sync:model-runs": "node scripts/sync-model-runs.mjs",
    "sync:model-decisions": "node scripts/sync-model-decisions.mjs",
    "sync:strategy-operations": "node scripts/sync-strategy-operations.mjs",
    "sync:market-evidence": "node scripts/sync-market-evidence.mjs",
    "sync:model-data": "node scripts/sync-model-data.mjs",
    "sync:research-assets": "npm run sync:formal-model-runs && npm run sync:model-runs && npm run sync:model-decisions && npm run sync:strategy-operations && npm run sync:market-evidence && npm run sync:model-data",
    "check:i18n": "node scripts/check-ui-language.mjs",
    "check:account": "node scripts/check-account.mjs",
    "check:formal-evidence": "node scripts/check-formal-evidence-contract.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate --registry=https://registry.npmjs.org",
    "dev": "npm run sync:research-assets && vite",
    "build": "npm run check:i18n && npm run check:account && npm run sync:research-assets && npm run check:formal-evidence && vitest run && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "npm run check:i18n && npm run check:account && npm run sync:research-assets && npm run check:formal-evidence && vitest run",
    "test:watch": "vitest",
    "test:coverage": "npm run check:i18n && npm run check:account && npm run sync:research-assets && npm run check:formal-evidence && vitest run --coverage",
    "e2e": "npm run build && playwright test",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@tanstack/react-virtual": "^3.13.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
