# =============================================================================
# Alpha Engine — Research Environment Configuration
# =============================================================================
# Copy this file to .env only when a local research workflow needs overrides.
# The Research Artifact Studio is a static PWA and does not read this file.
# =============================================================================

# Runtime label used by Python workflows.
# ALPHA_ENGINE_ENV=development

# ---------------------------------------------------------------------------
# Research paths (optional; relative paths resolve from the project root)
# ---------------------------------------------------------------------------

# TRADING_CONFIG_DIR=configs
# TRADING_DATA_DIR=data
# TRADING_REPORTS_DIR=reports
# TRADING_SCRIPTS_DIR=scripts
# TRADING_ARTIFACTS_DIR=artifacts

# Override the metadata SQLite database path.
# TRADING_ASSISTANT_METADATA_DB_PATH=

# ---------------------------------------------------------------------------
# Research and risk controls
# ---------------------------------------------------------------------------

# ALPHA_ENGINE_MAX_DRAWDOWN_THRESHOLD=0.15
# SCORING_TIMEOUT_SEC=60
# MAX_LEVERAGE=1.0

# Long-running job guards (0 disables a timeout / breaker).
# ALPHA_ENGINE_JOB_TIMEOUT_SECONDS=14400
# ALPHA_ENGINE_MAX_CONCURRENT_JOBS=2
# ALPHA_ENGINE_DATA_REPAIR_TIMEOUT_SECONDS=1800
# ALPHA_ENGINE_ROUTER_FAILURE_THRESHOLD=5

# Data-update download concurrency (1 disables parallel fetching).
# ALPHA_ENGINE_UPDATE_WORKERS=4

# ---------------------------------------------------------------------------
# Data and research integrations
# ---------------------------------------------------------------------------

# OPENAI_API_KEY=sk-...
# SEC_USER_AGENT=AlphaEngine Research your-contact@example.com
# DATABASE_URL=sqlite:///data/local_market.db
# TRADING_WEBHOOK_URL=

# Optional token for the separately owned MCP JSON-RPC integration.
# It is unrelated to the static Web product.
# ALPHA_DEVELOPER_TOKEN=
