# Auto-detect text files and normalize line endings
* text=auto

# Python
*.py text eol=lf
*.pyw text eol=lf

# TypeScript / JavaScript / JSON / CSS
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
.env.example text eol=lf

# Documentation
*.md text eol=lf
*.rst text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.pkl binary
*.png binary
*.jpg binary
*.ico binary
*.db binary

# Small immutable formal-source archives are retained directly in Git so
# reproducibility does not depend on expiring GitHub Actions artifacts.
data/research/formal_promotions/archive/*.zip binary

# Governed terminal history is raw-byte hash bound by the lifecycle registry.
data/csv_clean/EA.csv text eol=lf

# Content-addressed research artifacts are verified byte-for-byte via sha256.
# Force LF on checkout so Windows autocrlf cannot break hash verification.
*.csv text eol=lf
*.tsv text eol=lf
*.jsonl text eol=lf

# Durable large research-run evidence. Small JSON manifests and curves stay in normal Git.
data/research/runs/**/*.parquet filter=lfs diff=lfs merge=lfs -text
data/research/runs/**/*.pkl filter=lfs diff=lfs merge=lfs -text
data/research/runs/**/*.bin filter=lfs diff=lfs merge=lfs -text
data/research/runs/**/*.joblib filter=lfs diff=lfs merge=lfs -text
data/research/runs/**/*.onnx filter=lfs diff=lfs merge=lfs -text
