{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuh886/alpha_engine/schemas/research/us_x1_1_sector_cap_shadow_receipt_v1.schema.json",
  "title": "US x1.1 sector-cap prospective shadow receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "shadow_contract_id",
    "signal_session_date",
    "receipt_created_at_utc",
    "source_data_cutoff",
    "outcomes_available",
    "research_only",
    "trade_ready",
    "identities",
    "portfolio_contract",
    "summary",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 16},
    "shadow_contract_id": {"const": "us_x1_1_sector_cap_shadow_v1"},
    "signal_session_date": {"type": "string", "format": "date"},
    "receipt_created_at_utc": {"type": "string", "format": "date-time"},
    "source_data_cutoff": {"type": "string", "format": "date"},
    "outcomes_available": {"const": false},
    "research_only": {"const": true},
    "trade_ready": {"const": false},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "pool_id",
        "pool_file_sha256",
        "classification_file_sha256",
        "classification_records_sha256",
        "shadow_contract_file_sha256",
        "score_input_sha256",
        "provider_snapshot_identity",
        "repository_commit",
        "workflow_run_id"
      ],
      "properties": {
        "model_id": {"const": "us_x1_1"},
        "pool_id": {"const": "us_selected_equities_v2"},
        "pool_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "classification_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "classification_records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "shadow_contract_file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "score_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provider_snapshot_identity": {"type": "string", "minLength": 8},
        "repository_commit": {"type": "string", "minLength": 7},
        "workflow_run_id": {"type": "string", "minLength": 1}
      }
    },
    "portfolio_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_n",
        "equal_weight",
        "maximum_names_per_sector",
        "maximum_sector_weight",
        "holding_sessions",
        "rebalance_sessions"
      ],
      "properties": {
        "top_n": {"const": 15},
        "equal_weight": {"const": true},
        "maximum_names_per_sector": {"const": 4},
        "maximum_sector_weight": {"const": 0.26666666666666666},
        "holding_sessions": {"const": 10},
        "rebalance_sessions": {"const": 10}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score_rows",
        "eligible_score_rows",
        "baseline_names",
        "challenger_names",
        "overlap_count",
        "replacement_count",
        "baseline_expected_turnover",
        "challenger_expected_turnover",
        "challenger_max_sector_weight",
        "challenger_sector_hhi"
      ],
      "properties": {
        "score_rows": {"const": 87},
        "eligible_score_rows": {"type": "integer", "minimum": 15, "maximum": 87},
        "baseline_names": {"const": 15},
        "challenger_names": {"const": 15},
        "overlap_count": {"type": "integer", "minimum": 0, "maximum": 15},
        "replacement_count": {"type": "integer", "minimum": 0, "maximum": 15},
        "baseline_expected_turnover": {"type": "number", "minimum": 0},
        "challenger_expected_turnover": {"type": "number", "minimum": 0},
        "challenger_max_sector_weight": {"type": "number", "maximum": 0.266666666666667},
        "challenger_sector_hhi": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "files": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
