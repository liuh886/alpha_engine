{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha-engine.local/contracts/model-run-bundle-v2/catalog.schema.json",
  "title": "Model Run Bundle v2 channel catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "channel", "generated_at", "research_only", "trade_ready", "records"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "channel": { "enum": ["local", "preview", "formal"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "research_only": { "const": true },
    "trade_ready": { "const": false },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_family_id", "model_version_id", "run_id", "bundle_id", "model_kind", "publication_status", "manifest_path", "manifest_sha256", "evidence_cutoff"],
        "properties": {
          "model_family_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "model_version_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "bundle_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "model_kind": { "enum": ["rules_based_allocation", "cross_sectional_ranker", "forecast_model"] },
          "publication_status": { "enum": ["local_only", "ci_validated_preview", "accepted_formal_baseline", "rejected", "blocked"] },
          "manifest_path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*manifest\\.json$" },
          "manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "evidence_cutoff": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
