  "governed_workflows": [
    ".github/workflows/ci-governance.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/frontend-static-pwa.yml"
  ],
  "required_pr_workflows": [
    ".github/workflows/ci-governance.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/frontend-static-pwa.yml"
  ],
  "release_workflows": [
    ".github/workflows/deploy-pages.yml",
    ".github/workflows/formal-backtest-refresh.yml",
    ".github/workflows/formal-bundle-v2-sync.yml",
    ".github/workflows/current-formal-backtest-integrity.yml",
